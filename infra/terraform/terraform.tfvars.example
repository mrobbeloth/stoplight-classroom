# Copy to terraform.tfvars and fill in.

project     = "stoplight-classroom"
environment = "prod"
region      = "us-east-2"

# Set this to enable the GitHub Actions OIDC deploy role.
# Format: "owner/repo"
github_repository = "your-github-user/stoplight-classroom"

# Optional: pass an ACM cert ARN to enable HTTPS on the ALB and redirect HTTP -> HTTPS.
# acm_certificate_arn = "arn:aws:acm:us-east-2:123456789012:certificate/..."

# Optional: comma-separated CORS origin patterns. If empty, defaults to the ALB DNS over HTTP.
# cors_allowed_origins = "https://classroom.example.com"

# Email address that receives CloudWatch alarm notifications. AWS sends a
# confirmation email after `terraform apply` — click the link to start receiving alerts.
alarm_email = "you@example.com"

# Set to false to skip the CloudWatch dashboard (~$3/mo if past the always-free allowance).
# create_dashboard = true
